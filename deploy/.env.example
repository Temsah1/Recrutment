# Copy to deploy/.env and replace every placeholder. deploy/.env is gitignored.
# Real secrets belong only in this file (mode 0600) or a secret manager.

# Public hostname, no scheme. DNS A/AAAA records must point at this server.
APP_DOMAIN=apply.example.org

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
RECRUITMENT_TIMEZONE=Africa/Cairo

# --- Public origin / browser security ---------------------------------------
# Both must be the exact HTTPS origin served by Caddy.
PUBLIC_APP_URL=https://apply.example.org
TRUSTED_ORIGINS=https://apply.example.org
COOKIE_SAME_SITE=lax
TRUST_PROXY=true

# --- Secrets (required) ------------------------------------------------------
# Generate each value on the server, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# SESSION_SECRET: >= 32 characters. ADMIN_BOOTSTRAP_TOKEN: >= 24 characters.
SESSION_SECRET=replace-with-a-random-48-byte-base64url-secret
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token

# --- Sessions ----------------------------------------------------------------
SESSION_MAX_AGE_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=3600

# --- Uploads -----------------------------------------------------------------
# Default 5 MB; the Caddy request body limit is 25 MB.
MAX_UPLOAD_SIZE_BYTES=5242880
