# APP_DOMAIN is supplied by deploy/.env (for example apply.example.org).
# Caddy obtains and renews the TLS certificate automatically on ports 80/443.
{$APP_DOMAIN} {
	encode zstd gzip

	# Must stay above MAX_UPLOAD_SIZE_BYTES (5 MB default).
	request_body {
		max_size 25MB
	}

	# Never fall through to the SPA for API calls.
	@api path /api/*
	handle @api {
		reverse_proxy {$API_UPSTREAM:api:4000}
	}

	handle {
		root * {$WEB_ROOT:/srv}
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
	}
}
