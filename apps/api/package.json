{
  "name": "@esme/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/cli/migrate.ts",
    "admin:bootstrap": "tsx src/cli/bootstrap-admin.ts",
    "db:backup": "tsx src/cli/backup.ts",
    "db:restore": "tsx src/cli/restore.ts",
    "storage:verify": "tsx src/cli/verify-storage.ts",
    "seed:demo": "tsx src/cli/seed-demo.ts"
  },
  "dependencies": {
    "@esme/shared": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.2.2",
    "@node-rs/argon2": "^2.0.2",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "file-type": "^19.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^3.0.5"
  }
}
