# ESME Recruitment OS — environment template
# Copy to .env for local development, then replace every placeholder.
# Never commit the real .env. Explicit process environment variables always win
# over values in this file.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
# Bind 0.0.0.0 when the API runs in a container or behind a reverse proxy.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=debug

# --- Public site / CORS ------------------------------------------------------
# Must be HTTPS in production (e.g. https://apply.example.org).
PUBLIC_APP_URL=http://localhost:5173
# Extra comma-separated origins allowed for CORS and unsafe requests.
# TRUSTED_ORIGINS=https://admin.example.org

# --- Secrets -----------------------------------------------------------------
# Required in production, minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-random-48-byte-base64url-secret
# Required to run admin:bootstrap in production, minimum 24 characters.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token

# --- Sessions ----------------------------------------------------------------
SESSION_MAX_AGE_SECONDS=43200
SESSION_IDLE_TIMEOUT_SECONDS=3600
# lax | strict | none. "none" requires HTTPS (cross-site frontend hosting).
COOKIE_SAME_SITE=lax
# true only when a trusted reverse proxy sets X-Forwarded-* headers.
TRUST_PROXY=false

# --- Storage (never inside apps/web) -----------------------------------------
# Base directory for the database, private uploads and backups.
APP_DATA_DIR=./var/app
# DATABASE_PATH=./var/app/db/esme-recruitment.sqlite
# PRIVATE_UPLOADS_DIR=./var/app/uploads
# BACKUP_DIR=./var/app/backups
# MIGRATIONS_DIR=./database/migrations

# --- Uploads / locale --------------------------------------------------------
# Server-side limit in bytes (10 KB – 20 MB). Default 5 MB.
MAX_UPLOAD_SIZE_BYTES=5242880
RECRUITMENT_TIMEZONE=Africa/Cairo

# --- Frontend build ----------------------------------------------------------
# Keep relative when the web host proxies /api to the API.
VITE_API_BASE_URL=/api/v1
# Only used by the Vite dev server proxy.
VITE_DEV_API_TARGET=http://127.0.0.1:4000

# --- One-time bootstrap (do NOT keep these in production after bootstrap) ----
# ADMIN_EMAIL=you@example.org
# ADMIN_NAME=Your Name
# ADMIN_BOOTSTRAP_PASSWORD=
